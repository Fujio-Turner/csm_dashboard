{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://csm-dashboard.local/schema/credential.schema.json",
  "title": "Credential",
  "type": "object",
  "additionalProperties": true,
  "required": ["type", "kind", "name"],
  "properties": {
    "type": { "const": "credential" },
    "kind": { "type": "string", "enum": ["ai", "connector"] },
    "name": { "type": "string", "minLength": 1 },
    "secret": { "type": "object", "additionalProperties": true },
    "updated_at": { "type": "string" }
  }
}
