{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://csm-dashboard.local/schema/account.schema.json",
  "title": "Account",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "type",
    "account_id",
    "name",
    "abbr",
    "slug",
    "color"
  ],
  "properties": {
    "type": {
      "const": "account"
    },
    "account_id": {
      "type": "string",
      "pattern": "^acct:[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "abbr": {
      "type": "string",
      "pattern": "^[A-Z0-9]{2,6}$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    }
  }
}
