{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://csm-dashboard.local/schema/sync_job.schema.json",
  "title": "Sync job",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "type",
    "connector"
  ],
  "properties": {
    "status": {
      "enum": [
        "queued",
        "running",
        "done",
        "error",
        "partial"
      ]
    }
  }
}
